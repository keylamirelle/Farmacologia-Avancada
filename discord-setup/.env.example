# Token do bot, gerado em https://discord.com/developers/applications
# > sua aplicação > aba "Bot" > "Reset Token".
# NUNCA cometa o arquivo .env de verdade no git -- ele já está no .gitignore.
DISCORD_BOT_TOKEN=

# ID numérico do servidor (modo desenvolvedor > botão direito no servidor
# > "Copiar ID"). Também pode ser preenchido em config.yaml (server.guild_id);
# se os dois estiverem definidos, esta variável tem prioridade.
DISCORD_GUILD_ID=
